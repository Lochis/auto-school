flowchart LR
    subgraph K8S["k3s homelab - CloudNativePG"]
        subgraph DAEMON["auto-school daemon :7800"]
            REC["Recorder segments/*.webm"] --> SEG["segment.ts batch Gemini + audio"]
            SEG --> TLJ["out/timeline.jsonl crash journal"]
            SEG --> TSEG[("transcript_segments")]
            SEG --> NOTES["notes.ts fold + finalize"]
            NOTES --> ART[("session_artifacts notes md, timeline")]
            REC --> CONS["consolidate.ts webm stream-copy"]
            CONS --> BLOB["Blob storage recordings/ PVC now, S3/MinIO later"]
            CONS --> ART
            CAL["calendar scan"] --> MAP[("meeting_mappings")]
            MAP --> REC
            SEG --> PIPE[("sessions stage updates")]
            NOTES --> PIPE
            CONS --> PIPE
            RET["retention job retained_until / deleted_at"] --> BLOB
            RET --> ART
            MAT["materials upload courses/<slug>/materials"] --> DOCS[("documents")]
            MAT --> PAGES[".index page bundles pdftotext, pdftoppm"]
            PAGES --> EMB["embedding backfill materials, notes, transcripts"]
            EMB --> CHUNKS[("document_chunks pgvector HNSW")]
            DL["deadline rebuild daemon routes"] --> DLT[("deadlines, folds, checklist_items")]
        end

        PG[("PostgreSQL 17 + pgvector CloudNativePG Cluster")]
        PITR["Barman backups S3/MinIO PITR"]

        subgraph FE["Next.js frontend :3000"]
            UI["Courses / sessions / notes server components"]
            CHAT["Course chat semantic_search + read_document"]
            MEDIA["Media player HTTP Range"]
        end

        AUTH["Authentik OIDC users.id owner_user_id"]
    end

