{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/courses/[slug]",
      "regex": "^/api/courses/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/courses/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/courses/[slug]/chat",
      "regex": "^/api/courses/([^/]+?)/chat(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/courses/(?<nxtPslug>[^/]+?)/chat(?:/)?$"
    },
    {
      "page": "/api/courses/[slug]/config",
      "regex": "^/api/courses/([^/]+?)/config(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/courses/(?<nxtPslug>[^/]+?)/config(?:/)?$"
    },
    {
      "page": "/api/courses/[slug]/materials",
      "regex": "^/api/courses/([^/]+?)/materials(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/courses/(?<nxtPslug>[^/]+?)/materials(?:/)?$"
    },
    {
      "page": "/api/media/[...path]",
      "regex": "^/api/media/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/media/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/course/[slug]",
      "regex": "^/course/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/course/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/course/[slug]/session/[stem]",
      "regex": "^/course/([^/]+?)/session/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug",
        "nxtPstem": "nxtPstem"
      },
      "namedRegex": "^/course/(?<nxtPslug>[^/]+?)/session/(?<nxtPstem>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}