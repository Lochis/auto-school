# --- Teams account ---
TEAMS_EMAIL=you@school.edu
# Leave blank to be prompted interactively when a password field appears
TEAMS_PASSWORD=

CENTENNIAL_USER=
CENTENNIAL_PASSWORD=

# --- Discord webhook (2FA pings) ---
# Server Settings -> Integrations -> Webhooks -> New Webhook, copy URL
DISCORD_WEBHOOK_URL=

# --- Options ---
# Persistent Chromium profile. Survives restarts -> MFA normally only needed once.
USER_DATA_DIR=./user-data
# Minutes to wait for you to complete 2FA after the ping
MFA_WAIT_MINUTES=10
# Chromium channel: "chromium" (default, bundled) or "msedge" if Teams blocks vanilla Chromium
BROWSER_CHANNEL=
