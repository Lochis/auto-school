# --- Teams account ---
TEAMS_EMAIL=you@school.edu
# Optional — if unset, an MS password prompt is filled with CENTENNIAL_PASSWORD
# (federated school accounts usually share the same password)
TEAMS_PASSWORD=

CENTENNIAL_USER=
CENTENNIAL_PASSWORD=

# --- Discord webhook (2FA pings) ---
# Server Settings -> Integrations -> Webhooks -> New Webhook, copy URL
DISCORD_WEBHOOK_URL=

# --- Options ---
# Persistent Chromium profile. Survives restarts -> MFA normally only needed once.
# Profile location. UNSET = local disk (~/.auto-school/user-data) — recommended.
# Only set this if you must (repo on network drive => Chromium stalls).
#USER_DATA_DIR=./user-data
# Minutes to wait for you to complete 2FA after the ping
MFA_WAIT_MINUTES=10
# Chromium channel: "chromium" (default, bundled) or "msedge" if Teams blocks vanilla Chromium
BROWSER_CHANNEL=

# --- Automatic MFA (TOTP) ---
# Base32 secret for your Authenticator account (from when you first set it up,
# or re-enroll and choose "can't scan / show code"). Set = fully automatic login.
TOTP_SECRET=

# --- Graph API (meeting discovery) ---
# Default = Microsoft's Graph PowerShell first-party public client (device code OK,
# no own app registration needed — runs as YOUR account). Only change if blocked.
GRAPH_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e
GRAPH_TENANT_ID=

ASR_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
